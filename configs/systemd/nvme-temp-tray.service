[Unit]
Description=NVMe temperature in system tray
# Заметка (не для systemd): создано Пятницей 04.10.2026 — значок с температурой NVMe в трее wf-panel-pi

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/.local/bin/nvme-temp-tray.py
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# если упадёт (например, перезапуск графической сессии) — поднимется сам
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
